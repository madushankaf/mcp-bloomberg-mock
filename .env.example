# ---- Backend ---------------------------------------------------------------
# auto | blpapi | mock   (auto = use Bloomberg if reachable, else mock data)
BLOOMBERG_MODE=auto

# Desktop API: Terminal running + logged in on this machine.
# SAPI / B-PIPE: point at the appliance host.
BLOOMBERG_HOST=localhost
BLOOMBERG_PORT=8194
BLOOMBERG_TIMEOUT_MS=30000

# B-PIPE / SAPI only
# BLOOMBERG_AUTH_OPTIONS=AuthenticationType=OS_LOGON
# BLOOMBERG_AUTH_OPTIONS=AuthenticationMode=APPLICATION_ONLY;ApplicationAuthenticationType=APPNAME_AND_KEY;ApplicationName=my-app
# BLOOMBERG_TLS_CLIENT_CERT=/path/client.pk12
# BLOOMBERG_TLS_CLIENT_CERT_PASSWORD=changeit
# BLOOMBERG_TLS_TRUST_MATERIAL=/path/rootCertificate.pk7

# ---- Guardrails ------------------------------------------------------------
BLOOMBERG_MAX_SECURITIES=100
BLOOMBERG_MAX_FIELDS=50

# ---- HTTP / MCP transport --------------------------------------------------
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=8000
MCP_PATH=/mcp
# Keep both true behind WSO2: no session affinity, plain JSON instead of SSE.
MCP_STATELESS=true
MCP_JSON_RESPONSE=true
# DNS-rebinding protection: leave empty behind a gateway (the Host header is the
# gateway's), or list allowed hosts e.g. bloomberg-mcp:8000,localhost:*
# MCP_ALLOWED_HOSTS=
# MCP_ALLOWED_ORIGINS=

# Shared secret the gateway must present (x-api-key or Authorization: Bearer)
# MCP_API_KEY=change-me
MCP_API_KEY_HEADER=x-api-key

LOG_LEVEL=info
